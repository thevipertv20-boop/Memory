{
  "name": "memory",
  "version": "1.0.0",
  "description": "Memory-Spiel (Developer Akademie) – HTML, SCSS, TypeScript",
  "private": true,
  "type": "module",
  "scripts": {
    "build:sass": "sass scss/main.scss css/main.css",
    "watch:sass": "sass --watch scss/main.scss css/main.css",
    "build:ts": "tsc",
    "watch:ts": "tsc --watch",
    "build": "npm run build:sass && npm run build:ts",
    "dev": "npm run watch:sass & npm run watch:ts"
  },
  "devDependencies": {
    "sass": "^1.104.0",
    "typescript": "^5.6.0"
  }
}